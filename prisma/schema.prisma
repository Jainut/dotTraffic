generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgres"
  url      = env("DATABASE_URL")
}

model Transformador {
  idTransformador   String @id @default(uuid())
  numeroDeSerie Int @unique
  modelo String
  potenciaKva Decimal @db.Decimal(10, 2)
  statusProducao String
  temperatura Decimal @db.Decimal(10, 2)
  dataRegistro DateTime @default(now())

  logs LogEventos[]
}

model LogEventos {
  idLog String @id @default(uuid())
  idTransformador String
  tipoEvento String
  descEvento String
  dataHora DateTime @default(now())
  
  transformador Transformador @relation(fields: [idTransformador], references: [idTransformador])
}
